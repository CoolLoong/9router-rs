{
  "schema": "rust-anything/app-cases@1",
  "name": "server",
  "run": [
    "sh",
    "rust/reference/server.sh"
  ],
  "normalize": [
    "timestamps",
    "uuids"
  ],
  "normalizers": {
    "created-seconds": "\"created\":[0-9]{10}",
    "key-nonce": "sk-[0-9a-f]{16}-[a-z0-9]{6}-[a-f0-9]{8}",
    "locale-expiry": "Expires=[A-Z][a-z]{2}, [0-9]{2} [A-Z][a-z]{2} [0-9]{4} ([0-9:]{8}|\\[\\.\\.\\]) GMT",
    "web-timing": "\"(response_time_ms|upstream_latency_ms)\":[0-9]+"
  },
  "timeout_secs": 12,
  "http": {}
}
